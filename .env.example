# Neon (PostgreSQL) connection string
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Must be 32+ random characters or the server refuses to start. `npm run setup` fills this in for you.
# Or generate one yourself on any OS:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origin(s) of the client app, used for CORS. Comma-separate several, no trailing slash.
# Production example: https://aatmabal.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Upstash Redis (Upstash console -> your database -> REST API section).
# Optional: leave empty to run without a cache. On Vercel, the Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which are also understood.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# PORT=4000
# DB_POOL_MAX=3

# Bill Book photos are stored in Supabase Storage (private bucket, created automatically).
# Supabase dashboard -> Project Settings -> API: copy the Project URL and the "service_role" key.
# Paste ONLY the value after the = sign (for example SUPABASE_URL=https://abcdxyz.supabase.co),
# not the variable name from Supabase's snippet.
# The service key is a SECRET: it lives only here on the server, never in the client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=bill-images
